# PostgreSQL (na Railway přidej plugin Postgres → proměnná se vytvoří sama)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Claude API
ANTHROPIC_API_KEY="sk-ant-..."
# Volitelné – jiný endpoint (např. brána). Pokud nepoužíváš, nech nevyplněné.
# ANTHROPIC_BASE_URL="https://api.anthropic.com"
# Volitelné – přepsání modelu (výchozí: claude-sonnet-4-6)
# ANTHROPIC_MODEL="claude-sonnet-4-6"
