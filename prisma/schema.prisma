generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Machine {
  id           String     @id @default(cuid())
  name         String
  line         String? // výrobní linka (pro seskupení); null = bez linky
  retired      Boolean    @default(false) // vyřazený stroj – všude se ignoruje
  type         String?
  manufacturer String?
  year         Int?
  location     String?
  photoUrl     String?
  manualText   String?    @db.Text
  notes        String?    @db.Text
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  entries      LogEntry[]
  documents    Document[]
}

model Document {
  id        String   @id @default(cuid())
  machineId String
  machine   Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  fileId    String? // ID z Anthropic Files API (u textového source je null)
  filename  String
  mediaType String
  kind      String   @default("manual") // manual | hydraulika | elektro | plc | jine
  isImage   Boolean  @default(false)
  sizeBytes Int?
  rawText   String?  @db.Text // textový source (PLC SCL/STL/XML…)
  digest    String?  @db.Text // výtažek toho důležitého (předpřipravený při nahrání)
  createdAt DateTime @default(now())

  @@index([machineId])
}

model LogEntry {
  id              String   @id @default(cuid())
  extId           String?  @unique // ID_REQUE_NUMBE z exportu – pro inkrementální import
  machineId       String
  machine         Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  occurredAt      DateTime @default(now())
  problem         String   @db.Text
  solution        String?  @db.Text
  partsCost       Int?
  downtimeMinutes Int?
  technician      String?
  reporter        String? // kdo nahlásil (Zadavatel)
  repairer        String? // kdo opravil (kód operátora z údržbového záznamu)
  createdAt       DateTime @default(now())

  @@index([machineId])
  @@index([repairer])
}
